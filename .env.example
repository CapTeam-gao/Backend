MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=gao_db
MYSQL_USER=gao_user
MYSQL_PASSWORD=change-me

SPRING_DATASOURCE_URL=jdbc:mysql://gao-mysql:3306/gao_db?serverTimezone=Asia/Seoul&useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_unicode_ci

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRATION=4800000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000
JWT_REFRESH_COOKIE_SECURE=true
JWT_REFRESH_COOKIE_SAME_SITE=None

WEBSOCKET_ALLOWED_ORIGINS=https://capteam.n-e.kr
AI_SERVER_BASE_URL=http://ai-server:8000
INTERNAL_MATCHING_API_KEY=replace-with-a-long-random-shared-key

FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_FILE=

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=replace-with-your-private-bucket
AWS_S3_KEY_PREFIX=chat
AWS_S3_PRESIGNED_URL_DURATION=PT10M

CHAT_FILE_STORAGE_TYPE=s3
CHAT_FILE_LOCAL_ROOT=/tmp/gao-chat-files
CHAT_FILE_MAX_SIZE=20MB
CHAT_FILE_MAX_REQUEST_SIZE=20MB

TZ=Asia/Seoul
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
BACKEND_IMAGE=ghcr.io/capteam-gao/backend:latest
BACKEND_CPUS=1.5
MYSQL_CPUS=1.0
