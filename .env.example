MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MYSQL_DATABASE=gao_db
MYSQL_USER=gao_user
MYSQL_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000
JWT_REFRESH_COOKIE_SECURE=true
JWT_REFRESH_COOKIE_SAME_SITE=None

WEBSOCKET_ALLOWED_ORIGINS=https://frontend.example.com
AI_SERVER_BASE_URL=http://host.docker.internal:8000

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=replace-with-your-private-bucket-name
AWS_S3_KEY_PREFIX=chat
AWS_S3_PRESIGNED_URL_DURATION=PT10M

CHAT_FILE_MAX_SIZE=20MB
CHAT_FILE_MAX_REQUEST_SIZE=20MB
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8888
